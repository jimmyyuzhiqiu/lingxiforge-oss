# Required: generate a unique secret with openssl rand -hex 32 and paste it here.
LINGXIFORGE_AUTH_SALT=

# Comma-separated allowed browser origins. Adjust for your deployment.
LINGXIFORGE_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Optional: external compatible 3D inference API. Leave empty to disable model generation.
HY3D_BASE_URL=
HY3D_TIMEOUT_SECONDS=600
